# Obtain the key from https://console.anthropic.com/
ANTHROPIC_API_KEY=replace_with_your_key

# Cost-effective model with tool-use support.
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Optional overrides
# MCP_CONFIG_PATH=config/servers.json
# MCP_LOG_PATH=logs/mcp_interactions.jsonl
# MAINTENANCE_DATA_PATH=data/maintenance.json

# Remote MCP server/client settings (second part of the project)
# MCP_REMOTE_URL=https://your-service.example/mcp
# MCP_AUTH_TOKEN=replace_with_a_long_random_value
# MCP_ALLOWED_ORIGINS=https://your-chatbot.example
# MCP_HOST=127.0.0.1
# PORT=8000

