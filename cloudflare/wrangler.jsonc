{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "industrial-maintenance-mcp",
  "main": "src/index.js",
  "compatibility_date": "2026-09-18",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "MAINTENANCE_STATE",
        "class_name": "MaintenanceState"
      }
    ]
  },
  "exports": {
    "MaintenanceState": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
